#include <winres.h>
#include "resource.h"
1 ICON "app.ico"

// Inter Display (SIL Open Font License 1.1, see OFL.txt), loaded privately via DirectWrite.
IDR_FONT_TIME RCDATA "..\\fonts\\InterDisplay-Bold.ttf"
IDR_FONT_DATE RCDATA "..\\fonts\\InterDisplay-Medium.ttf"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Overlook"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductName", "Overlook"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "OriginalFilename", "Overlook.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
